# ==== Niu Gayo Agroclimate — variabel lingkungan server (salin ke .env / systemd EnvironmentFile) ====
# Semua bersifat opsional kecuali ditandai WAJIB untuk fitur terkait. Jangan commit nilai asli.

# --- Server (sudah ada) ---
PORT=7455
PROXY_TTL_MIN=10          # cache /api/weather
ENSEMBLE_TTL_MIN=30
ALERTS_TTL_MIN=10
WN2_TTL_MIN=30
BMKG_TTL_MIN=10           # nowcast CAP RSS

# --- Diseminasi Telegram (sudah ada; dibaca dari env atau ~/.hermes/.env) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
TELEGRAM_CRON_THREAD_ID=55

# --- NASA IMERG (sudah ada; token dibaca dari ~/.netrc baris 'machine urs.earthdata.nasa.gov') ---
# Tidak lewat env. Lihat server/imerg.js.

# ==== Multi-bahaya (Fase 1–4, lihat docs/dev/) ====

# --- Hazard registry & diseminasi (Sprint 3: Fase 0.5, 1.8, 1.8b) ---
HAZARDS_ENABLED=*         # '*' semua, atau daftar id dipisah koma: longsor,banjir,angin,badai,asap,kebakaran,kekeringan,gempa,vulkanik,suhu,karat ('' = panel nonaktif)
HAZARDS_TTL_MIN=10        # cache /api/hazards (per lokasi & ?location=all)
ALERTS_CRON_TOKEN=        # WAJIB bila /api/alerts/run dipanggil dari luar loopback; header x-cron-token (lihat scripts/alerts-cron.mjs)
PUBLIC_URL=https://cuaca.abstract.biz.id/        # tautan dashboard di pesan Telegram/WhatsApp/CAP (lihat README "Live Site")
API_BASE=http://127.0.0.1:7455                   # dipakai scripts/alerts-cron.mjs (timer systemd)
# Klien (Vite, dibaca saat build): batasi hazard yang dirender HazardPanel; kosong = semua
# VITE_HAZARDS_ENABLED=longsor,banjir,angin,badai,asap,kebakaran,kekeringan,gempa,vulkanik,suhu,karat

# H-API hotspot — WAJIB untuk hotspot FIRMS. Daftar gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FIRMS_BBOX=96.1,3.9,97.5,5.2
FIRMS_TTL_MIN=30          # kuota 5.000 transaksi / 10 menit per kunci
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT   # 4 panggilan per refresh
FIRMS_DAYS=2              # 1–10; jendela kartu 24/48 jam

# H-ASAP — Open-Meteo Air Quality (CAMS), tanpa kunci
AQ_TTL_MIN=60             # CAMS diperbarui ~2x/hari; 60 menit cukup

# FWI/HTH — Open-Meteo Archive (ERA5), tanpa kunci
ARCHIVE_TTL_MIN=720       # arsip tertinggal 1–2 hari; cukup 12 jam
ARCHIVE_DAYS=92           # spin-up FWI 90 hari + ≥ 61 hari agar kelas HTH "Ekstrem" terdeteksi
ARCHIVE_MAX_LAG_DAYS=7    # lag arsip > ini → payload degraded (celah diisi prakiraan past_days=7)

# H-BANJIR+ — Open-Meteo Flood (GloFAS), tanpa kunci
FLOOD_TTL_MIN=360

# H-PETIR — Open-Meteo ECMWF (cape, kode cuaca, hembusan) + GFS (cape, lifted_index, CIN), tanpa kunci (Fase 2.3)
CONVECTIVE_TTL_MIN=30

# H-GEMPA — BMKG TEWS JSON (gempadirasakan/autogempa/gempaterkini) + riwayat USGS statis, tanpa kunci (Fase 2.1)
QUAKE_TTL_MIN=2

# H-VULKANIK — MAGMA Indonesia (HTML publik tingkat aktivitas), tanpa kunci (Fase 2.2b)
VOLCANO_TTL_MIN=60
MAGMA_STALE_DAYS=7        # pakai hasil lama bila fetch gagal
# Override manual status gunung api: path JSON {"burniTelong":{"level":"II","asOf":"2026-10-14","source":"...","force":false}}
# dipakai bila parser MAGMA gagal/berubah (sebelum nilai terakhir tersimpan); "force": true → selalu menimpa hasil parser
VOLCANO_OVERRIDE_PATH=

# PetaBencana.id (laporan warga eksternal, CC BY-NC 4.0; saring Aceh Tengah/Bener Meriah/Gayo Lues + 60 km) (Fase 2.4b)
PETABENCANA_TTL_MIN=10
# H-BANJIR+ — klimatologi debit & baseline SPI terversi di server/clim/ (bangun ulang 1×/tahun):
#   npm run clim:flood   → server/clim/flood-clim.json   (GloFAS 1984–tahun lalu; data efektif 1997+)
#   npm run clim:spi     → server/clim/spi-baseline.json (ERA5 1991–2020, 15 lokasi)

# --- Diseminasi Web Push (Fase 2, opsional; butuh devDependency `web-push`) ---
# Buat sekali: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
PUSH_MIN_LEVEL=bahaya     # waspada|bahaya|ekstrem

# --- Sensor PM2,5 mitra (Fase 4) — token per perangkat, dipisah koma: deviceId:token ---
SENSOR_TOKENS=
# contoh: SENSOR_TOKENS=pkm-bebesen-01:ganti_dengan_token_acak,sdn-1-takengon:token_lain

# --- Arsip harian untuk validasi KPI (ADR-26) ---
HAZARD_ARCHIVE_DIR=server/data/hazard-archive
