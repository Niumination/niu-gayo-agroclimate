# ==== Niu Gayo Agroclimate — variabel lingkungan server ====
# Gaya berkas ini sengaja "aman systemd EnvironmentFile" (temuan audit F-18):
#   - hanya baris `KUNCI=nilai` yang dibaca; komentar harus di baris sendiri
#     (komentar di akhir baris akan dianggap BAGIAN DARI NILAI oleh systemd).
# Salin ke .env atau pakai sebagai EnvironmentFile= systemd; jangan commit nilai asli.

# --- Server: port & TTL cache (menit) ---
PORT=7455
PROXY_TTL_MIN=10
ENSEMBLE_TTL_MIN=30
ALERTS_TTL_MIN=10
WN2_TTL_MIN=30
BMKG_TTL_MIN=10

# --- Diseminasi Telegram (dibaca dari env atau ~/.hermes/.env) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
TELEGRAM_CRON_THREAD_ID=55

# --- NASA IMERG ---
# Token dibaca dari ~/.netrc (baris: machine urs.earthdata.nasa.gov), bukan env. Lihat server/imerg.js.

# ==== Multi-bahaya (Fase 1–4, lihat docs/dev/) ====

# --- Hazard registry & diseminasi (Sprint 3: Fase 0.5, 1.8, 1.8b) ---
# '*' semua bahaya, atau daftar id dipisah koma; kosong = panel nonaktif
HAZARDS_ENABLED=*
HAZARDS_TTL_MIN=10
# WAJIB bila /api/alerts/run dipanggil dari luar loopback; header x-cron-token (scripts/alerts-cron.mjs)
ALERTS_CRON_TOKEN=
PUBLIC_URL=https://cuaca.abstract.biz.id/
API_BASE=http://127.0.0.1:7455
# Klien (Vite, dibaca saat build): batasi hazard HazardPanel; kosong = semua
# VITE_HAZARDS_ENABLED=longsor,banjir,angin,badai,asap,kebakaran,kekeringan,gempa,vulkanik,suhu,karat

# --- H-API hotspot FIRMS (WAJIB untuk hotspot; daftar kunci gratis di firms.modaps.eosdis.nasa.gov) ---
FIRMS_MAP_KEY=
FIRMS_BBOX=96.1,3.9,97.5,5.2
# kuota 5.000 transaksi / 10 menit per kunci
FIRMS_TTL_MIN=30
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
# 1–10 hari; jendela kartu 24/48 jam
FIRMS_DAYS=2

# --- H-ASAP: Open-Meteo Air Quality (CAMS), tanpa kunci ---
# CAMS diperbarui ~2x/hari; 60 menit cukup
AQ_TTL_MIN=60

# --- FWI/HTH: Open-Meteo Archive (ERA5), tanpa kunci ---
# arsip tertinggal 1–2 hari; cukup 12 jam
ARCHIVE_TTL_MIN=720
# spin-up FWI 90 hari + ≥ 61 hari agar kelas HTH "Ekstrem" terdeteksi
ARCHIVE_DAYS=92
# lag arsip > ini → payload degraded (celah diisi prakiraan past_days=7)
ARCHIVE_MAX_LAG_DAYS=7

# --- H-BANJIR+: Open-Meteo Flood (GloFAS), tanpa kunci ---
FLOOD_TTL_MIN=360

# --- H-PETIR: Open-Meteo ECMWF + GFS (cape, lifted_index, CIN), tanpa kunci (Fase 2.3) ---
CONVECTIVE_TTL_MIN=30

# --- H-GEMPA: BMKG TEWS JSON + riwayat USGS statis, tanpa kunci (Fase 2.1) ---
QUAKE_TTL_MIN=2
# radius relevansi gempa (km) untuk laporan per sentra
QUAKE_RADIUS_KM=300

# --- H-VULKANIK: MAGMA Indonesia (HTML publik), tanpa kunci (Fase 2.2b) ---
VOLCANO_TTL_MIN=60
# pakai hasil tersimpan bila fetch gagal, hanya bila umurnya ≤ nilai ini (hari)
MAGMA_STALE_DAYS=7
# Override manual status gunung api; path JSON:
#   {"burniTelong":{"level":"II","asOf":"2026-10-14","source":"...","force":false}}
# dipakai bila parser MAGMA gagal/berubah (sebelum nilai terakhir tersimpan); "force": true → selalu menimpa hasil parser
VOLCANO_OVERRIDE_PATH=

# --- PetaBencana.id: laporan warga eksternal (CC BY-NC 4.0; saring Aceh Tengah/Bener Meriah/Gayo Lues + 60 km) (Fase 2.4b) ---
PETABENCANA_TTL_MIN=10

# --- Klimatologi terversi di server/clim/ (bangun ulang 1×/tahun) ---
#   npm run clim:flood   → server/clim/flood-clim.json   (GloFAS 1984–tahun lalu; data efektif 1997+)
#   npm run clim:spi     → server/clim/spi-baseline.json (ERA5 1991–2020, 15 lokasi)

# --- Arsip harian untuk validasi KPI (ADR-26) ---
# default: server/data/hazard-archive (relatif akar repo)
HAZARD_ARCHIVE_DIR=

# --- Anggaran bundel (dipakai `npm run check:bundle`; default 150/200 kB gzip) ---
BUNDLE_MAX_KB=150
BUNDLE_TOTAL_MAX_KB=200

# ==== URL dasar sumber data (opsional — jarang perlu diubah; berguna untuk uji/mirror) ====
# Semua punya default bawaan di server/config.js bila dibiarkan kosong.
OPEN_METEO_AIR_QUALITY=
OPEN_METEO_ARCHIVE=
OPEN_METEO_FLOOD=
BMKG_QUAKE_BASE=
MAGMA_URL=
PETABENCANA_API=
FIRMS_API=

# ==== BELUM DIBACA KODE — rencana pasca-v2.0 (jangan diisi dulu; lihat docs/dev/10-ROADMAP-V3.md) ====
# Fitur Web Push ditunda ke v3: butuh devDependency `web-push` dan langganan klien.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
PUSH_MIN_LEVEL=bahaya
# Sensor PM2,5 mitra (Fase 4) — rencana: token per perangkat, dipisah koma: deviceId:token
SENSOR_TOKENS=
