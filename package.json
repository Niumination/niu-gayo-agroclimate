{
  "name": "niu-gayo-agroclimate",
  "private": true,
  "version": "2.2.5",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/write-build-info.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "lint": "eslint .",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:outlook": "node scripts/check-outlook.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "smoke": "node scripts/smoke.mjs",
    "validate:season": "node scripts/validate-season.mjs",
    "clim:flood": "node scripts/build-flood-clim.mjs",
    "clim:spi": "node scripts/build-spi-baseline.mjs",
    "check:build-info": "node scripts/check-build-info.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "check:a11y": "node scripts/a11y-gate.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
