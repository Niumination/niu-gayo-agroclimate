# eslint-plugin-jsx-a11y 6.10.2 (rilis terakhir Okt 2024) menyatakan peer eslint
# "^3 || ^4 || ^5 || ^6 || ^7 || ^8 || ^9" — belum mencakup ESLint 10, padahal
# pluginnya berjalan normal di 10 (aturan a11y terbukti menangkap temuan nyata).
# Tanpa baris ini `npm ci` (langkah CI) GAGAL ERESOLVE. Hapus baris ini begitu
# jsx-a11y merilis dukungan ESLint 10.
legacy-peer-deps=true
